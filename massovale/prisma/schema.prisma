generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id                       Int      @id @default(autoincrement())
  name                     String
  email                    String   @unique
  password                 String
  contact                  String
  role                     Role     @default(PACIENTE)
  emailVerified            Boolean  @default(false)
  emailVerificationToken   String?
  emailVerificationExpires DateTime?
  avatarUrl                String?

  // Relacionamentos
  appointmentsAsPaciente Appointment[] @relation("PatientAppointments")
  appointmentsAsClinico  Appointment[] @relation("ClinicoAppointments")
  blockedSlots           BlockedSlot[]
}

model BlockedSlot {
  id        Int      @id @default(autoincrement())
  date      DateTime
  clinico   User     @relation(fields: [clinicoId], references: [id])
  clinicoId Int

  @@unique([clinicoId, date])
}

model Appointment {
  id        Int      @id @default(autoincrement())
  date      DateTime
  patient   User     @relation("PatientAppointments", fields: [patientId], references: [id])
  patientId Int
  clinico   User     @relation("ClinicoAppointments", fields: [clinicoId], references: [id])
  clinicoId Int

  // --- ATUALIZAÇÕES AQUI ---
  status    AppointmentStatus @default(AGENDADO)
  service   String?
  notes     String?           @db.Text
  @@unique([clinicoId, date])
}

enum Role {
  PACIENTE
  CLINICO
}

enum AppointmentStatus {
  AGENDADO
  CONCLUIDO
  CANCELADO
}